# Copy to terraform.tfvars and replace every <PLACEHOLDER> with customer values.
project_id                 = "<PROJECT_ID>"
project_number             = "<PROJECT_NUMBER>"
organization_id            = "<ORGANIZATION_ID>"
region                     = "us-east4"
gateway_name               = "cff-egress-agw"
gateway_network_attachment = "<ATTACHMENT_NAME>" # a key in data/network-attachments/*.yaml

# Route both public and private endpoints through the Agent Gateway
access_types = ["PUBLIC", "PRIVATE"]

# Route all traffic through the VPC (needs Cloud NAT on the VPC for public endpoints)
vpc_egress = "ALL_TRAFFIC"

# Peer all DNS queries (".") to the VPC. The VPC needs a "." forwarding zone (public names)
# plus private zones for Google APIs / internal domains.
dns_peering_config = {
  domains        = ["."]
  target_network = "projects/<PROJECT_ID>/global/networks/<VPC_NAME>"
}

# Unregistered mode: no Agent Registries attached
registries = null

# Cloud Foundation Fabric factories (load all *.yaml files from each folder)
factories_config = {
  endpoints           = "./data/endpoints"
  network_attachments = "./data/network-attachments"
}
